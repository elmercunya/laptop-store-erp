      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// 1. Verificar que el login fue exitoso (Status 200)\r",
              "pm.test(\"Login exitoso (200 OK)\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Si el login es exitoso, extraer y guardar el token\r",
              "if (pm.response.code === 200) {\r",
              "    const responseJson = pm.response.json();\r",
              "    \r",
              "    // Guardar el token recibido en la variable de entorno \"token\"\r",
              "    pm.environment.set(\"token\", responseJson.token);\r",
              "    \r",
              "    console.log(\"✅ Token guardado automáticamente en el environment\");\r",
              "} else {\r",
              "    // Si falla el login (ej: contraseña incorrecta), borrar el token anterior\r",
              "    // para evitar usar credenciales viejas en los siguientes requests.\r",
              "    pm.environment.unset(\"token\");\r",
              "    console.log(\" Login fallido, token eliminado\");\r",
              "}"
            ]
          }
        }
      ]
    },
